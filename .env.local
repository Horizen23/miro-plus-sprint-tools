# Network & Domain Settings
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_JIRA_REDIRECT_URI=http://localhost:3000/panel

# Realtime Provider (socketio or supabase)
NEXT_PUBLIC_REALTIME_PROVIDER=socketio
